FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=/opt/venv/bin:$PATH

COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --frozen

COPY tests/fixtures/bronze /fixtures/bronze

ENV APP_ENV=docker
ENV DUCKLAKE_DATA_PATH=/data/verify/ducklake_verify.duckdb

CMD ["python", "-m", "lakehouse", "pipeline", "verify", "--fixture-dir", "/fixtures/bronze", "--clean"]
