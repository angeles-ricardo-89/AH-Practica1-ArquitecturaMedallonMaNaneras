# Copia a terraform.tfvars (NO se commitea; *.tfvars esta gitignored).
project          = "rag-conferencias-matutinas"
region           = "us-central1"
service_name     = "rag-del-pueblo"
artifact_repo    = "lakehouse"
image            = "us-central1-docker.pkg.dev/rag-conferencias-matutinas/lakehouse/app:latest"

demo_user_1_username = "demo_1"
demo_user_2_username = "demo_2"

# existing_secrets: los 4 son NOMBRES de secretos en Secret Manager.
# TELEGRAM_CHAT_ID debe crearse a mano (valor = id numerico del chat destino, p.ej. via @userinfobot);
# TELEGRAM_BOT_TOKEN ya existe. Anade ambas claves telegram_* a tu terraform.tfvars real (gitignored).
# Antes de desplegar: inicia un chat con el bot y enviale /start (si no, Telegram responde 403).
existing_secrets = {
  gemini_api_key     = "GEMINI_API_KEY"
  neon_db_url        = "NEON_DATABASE_URL"
  telegram_bot_token = "TELEGRAM_BOT_TOKEN"
  telegram_chat_id   = "TELEGRAM_CHAT_ID"
}
