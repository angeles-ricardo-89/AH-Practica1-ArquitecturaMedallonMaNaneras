# Ejemplo de configuracion productiva (Cloud Run + Neon + Gemini).
# Copiar a .env.production y reemplazar los placeholders. NO commitear valores reales.

APP_ENV=production

# Neon (conexion agrupada + TLS obligatorio). Host con sufijo -pooler y sslmode=require.
NEON_DATABASE_URL=<postgresql://USUARIO:CONTRASENA@endpoint-pooler.ejemplo.neon.tech/mananeras?sslmode=require>

# Gemini (Secret Manager en produccion)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_DIMENSION=768
INDEX_FORMAT_VERSION=v1

# Auth (secreto >= 32 chars, via Secret Manager)
JWT_SECRET=
CSRF_SECRET=

# Usuarios demo
DEMO_USER_1_USERNAME=
DEMO_USER_1_PASSWORD=
DEMO_USER_2_USERNAME=
DEMO_USER_2_PASSWORD=
